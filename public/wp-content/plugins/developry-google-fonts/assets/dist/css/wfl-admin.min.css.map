.wfl-admin {
	position: relative;
}

.wfl-admin h2 {
	font-size: 23px;
	font-weight: 400;
	margin-bottom: 20px;
}

.wfl-admin p {
	font-size: 14px;
	line-height: 26px;
	margin: 0 0 10px 0;
}

.wfl-admin p.submit {
	margin: 20px 0;
	padding: 0;
}

.wfl-admin form {
	float: left;
}

.wfl-admin form h2 {
	font-size: 20px;
}

.wfl-admin .wfl-pro {
	background-color: #ffffff;
	border-radius: 4px;
	float: right;
	margin: 0 20px 40px 40px;
	max-width: 420px;
	padding: 15px 30px;
}

.wfl-admin .wfl-pro h4 {
	font-size: 18px;
	margin: 15px 0;
}

.wfl-admin .wfl-pro table {
	background-color: #5af28c;
	border-collapse: collapse;
	border-radius: 4px;
	margin: 15px 0;
	text-align: center;
	width: 100%;
}

.wfl-admin .wfl-pro table th,
.wfl-admin .wfl-pro table td {
	border-bottom: 1px solid rgba(26, 28, 30, 0.15);
	border-collapse: collapse;
	color: #222325;
	font-size: 14px;
	padding: 8px;
}

.wfl-admin .wfl-pro table th {
	font-size: 16px;
}

.wfl-admin .wfl-pro .button-pro {
	background-color: #5af28c;
	border-color: rgba(26, 28, 30, 0.15);
	color: #222325;
	font-size: 18px;
	font-weight: 700;
	line-height: 38px;
}

.wfl-admin .wfl-pro .button-watch-video {
	background-color: #e0e1e3;
	border-color: rgba(26, 28, 30, 0.15);
	color: rgb(54.4142857143, 58.6, 62.7857142857);
	font-size: 14px;
	left: -2px;
	line-height: 38px;
	position: relative;
	top: -2px;
}

.wfl-upgrade a {
	color: #39b54a;
	display: inline-block;
	font-weight: 700;
}

.wfl-admin .wfl-support-credits p:not(p:first-child) {
	-webkit-box-align: center;
	-webkit-align-items: center;
	-ms-flex-align: center;
	align-items: center;
	display: -webkit-box;
